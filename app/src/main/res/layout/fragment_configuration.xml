<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/configurationTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Configurazione esercizio"
            android:textAlignment="center"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/scenarioLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Scenario"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/configurationTitle" />

        <RadioGroup
            android:id="@+id/scenarioRadioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scenarioLabel">

            <RadioButton
                android:id="@+id/bankingRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Banca e pagamenti" />

            <RadioButton
                android:id="@+id/accountItRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Account e assistenza IT" />

        </RadioGroup>

        <TextView
            android:id="@+id/difficultyLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Difficoltà"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scenarioRadioGroup" />

        <RadioGroup
            android:id="@+id/difficultyRadioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/difficultyLabel">

            <RadioButton
                android:id="@+id/easyRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Facile" />

            <RadioButton
                android:id="@+id/mediumRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Media" />

            <RadioButton
                android:id="@+id/hardRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Difficile" />

        </RadioGroup>

        <TextView
            android:id="@+id/lengthLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Lunghezza"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/difficultyRadioGroup" />

        <RadioGroup
            android:id="@+id/lengthRadioGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lengthLabel">

            <RadioButton
                android:id="@+id/shortRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Breve" />

            <RadioButton
                android:id="@+id/mediumLengthRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Media" />

            <RadioButton
                android:id="@+id/longRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lunga" />

        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startExerciseButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="24dp"
            android:text="Avvia esercizio"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lengthRadioGroup" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>